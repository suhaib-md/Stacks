{
  "name": "stacks",
  "version": "0.1.0",
  "private": true,
  "description": "Personal book catalog — barcode scan to cover-grid library",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply stacks-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stacks-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:backup": "wrangler d1 export stacks-db --remote --output backup.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "drizzle-orm": "^0.44.7",
    "html5-qrcode": "^2.3.8",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.86.0"
  }
}
